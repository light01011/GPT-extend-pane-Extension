{
  "manifest_version": 3,
  "name": "GPT_pane_widen",
  "version": "1.0",
  "description": "Widens the chat panes for Gemini and Claude.",
  "content_scripts": [
    {
      "matches": [
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
